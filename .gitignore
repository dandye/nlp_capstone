# Environments
.venv/
.venv-ml/
.python-version
__pycache__/
*.pyc

# Secrets
.env

# Model checkpoints (5.9GB; published to HF Hub, retraining repopulates)
models/

# BOND distant-supervision (external/bond); regenerable caches/outputs.
# The dataset/*_distant/*.json + data/gold_v2/distant.jsonl ARE tracked.
data/mitre-attack.json
external/*/outputs/
external/*/pretrained_model/
external/**/cached_*

# Raw scrape outputs left behind by design (clean.md is the committed artifact)
data/pdfs/
data/stix/
data/advisories.db
data/alerts/**/*.pdf
# raw docling markdown (the annotation-free source of clean.md); regenerable
data/alerts/**/*.md
!data/alerts/**/*.clean.md

# LaTeX build intermediates (paper/capstone/)
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.synctex.gz

# External benchmark dataset (MalwareTextDB-1.0, ~25MB, own license; unwired)
data/evals/

# Reference-paper library (data/papers/): track the docling .md conversions,
# not the raw PDFs (85MB, each paper's own copyright/license applies)
data/papers/*.pdf

# OS cruft
.DS_Store
# roborev snapshots
/.roborev/

# LaTeX build droppings
*.fdb_latexmk
*.fls
# stale truncated inference artifact (superseded)
data/frontier_results/gemma3-27b-entities.truncated-old.jsonl
