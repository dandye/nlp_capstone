paper := "capstone"
survey := "survey"
latex := "pdflatex -interaction=nonstopmode -halt-on-error"

# Build both PDFs
default: pdf survey-pdf

# Build the capstone paper (pdflatex -> bibtex -> pdflatex x2)
pdf:
    {{latex}} {{paper}}.tex
    bibtex {{paper}}
    {{latex}} {{paper}}.tex
    {{latex}} {{paper}}.tex

# Build the survey (pdflatex -> bibtex -> pdflatex x2)
survey-pdf:
    {{latex}} {{survey}}.tex
    bibtex {{survey}}
    {{latex}} {{survey}}.tex
    {{latex}} {{survey}}.tex

# NOTE: survey.tex is now hand-edited (survey.md is deprecated);
# the md->tex regeneration recipe was removed so it cannot clobber edits.

# Remove LaTeX build intermediates (keeps the PDFs)
clean:
    rm -f {{paper}}.aux {{paper}}.bbl {{paper}}.blg {{paper}}.log {{paper}}.out \
          {{survey}}.aux {{survey}}.log {{survey}}.out
